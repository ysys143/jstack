{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "declaration": true,
    "sourceMap": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "cli/**/*.ts",
    "runtime/**/*.ts",
    "packaging/**/*.ts",
    "scripts/**/*.ts",
    "hosts/**/*.ts",
    "skills/_suite_lib*.ts",
    "skills/public/engineering/skill-creator/scripts/**/*.ts",
    "skills/public/operations/session-memory/scripts/**/*.ts",
    "skills/public/artifacts/hwpx-document/hooks/*.ts",
    "skills/public/workflow/verify/scripts/*.ts",
    "skills/public/workflow/plan/scripts/*.ts",
    "skills/public/artifacts/humanize/scripts/*.ts",
    "skills/public/engineering/repository-setup/scripts/**/*.ts",
    "skills/public/operations/google-workspace/scripts/**/*.ts",
    "skills/support/runtime-adaptation/scripts/**/*.ts",
    "skills/public/workflow/test-driven-development/scripts/**/*.ts",
    "skills/public/artifacts/korean-proofread/scripts/**/*.ts",
    "skills/public/engineering/refactor/scripts/**/*.ts",
    "skills/public/research/research/scripts/**/*.ts",
    "skills/public/engineering/remove-capability/scripts/**/*.ts",
    "skills/support/git-conventions/scripts/**/*.ts",
    "skills/public/research/scientific-tools/scripts/**/*.ts",
    "skills/public/artifacts/svg-diagram/scripts/**/*.ts",
    "skills/public/workflow/second-opinion/scripts/**/*.ts",
    "skills/support/task-delegation/scripts/**/*.ts",
    "skills/public/artifacts/office-documents/scripts/**/*.ts",
    "tests/**/*.ts",
    "skills/public/artifacts/slides/scripts/**/*.ts",
    "skills/public/artifacts/image-generation/scripts/**/*.ts",
    "skills/public/artifacts/hwpx-document/scripts/**/*.ts",
    "skills/public/engineering/skill-creator/references/templates/**/*.ts",
    "skills/**/tests/**/*.ts",
    "skills/public/operations/disk-manager/scripts/**/*.ts",
    "skills/public/operations/issue-report/scripts/**/*.ts",
    "skills/support/host-audit/scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
