{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs",
      "**/*.ts",
      "**/*.tsx",
      "!skills/public/workflow/journey-qa/repos", "!skills/public/engineering/dag-it/repos", "!skills/public/engineering/statechart/repos", "!skills/public/engineering/create-formal-verification-skill/repos", "!hosts/claude/mods/*/**"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnreachable": "error"
      },
      "suspicious": {
        "noDebugger": "error",
        "noGlobalAssign": "error",
        "noSparseArray": "error"
      }
    }
  }
}
