{
  "hooks": {
    "PreToolUse": [
      {"matcher": "Bash|exec_command|apply_patch|Write|Edit|MultiEdit|NotebookEdit|Read", "hooks": [{"type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.js\" PreToolUse"}]}
    ],
    "PostToolUse": [
      {"matcher": "Write|Edit|MultiEdit|apply_patch", "hooks": [{"type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.js\" PostToolUse"}]}
    ],
    "Stop": [{"matcher": "", "hooks": [{"type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/commit-session.js\"", "async": true, "timeout": 120}]}],
    "SessionStart": [
      {"matcher": "startup", "hooks": [{"type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/load-recent-changes.js\""}]},
      {"matcher": "", "hooks": [{"type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/ensure-statusline.mjs\""}]}
    ]
  }
}
