#!/bin/sh
# Thin launcher for the jstack CLI shipped inside the plugin at payload/bin/jst, next
# to payload/cli/main.js. A Claude Code SessionStart hook adds this directory to
# the Bash tool's PATH, and the Codex SessionStart hook links ~/.local/bin/jst
# here. Design after ysys143/xsm bin/xsm: $0 may be that link, so follow the
# link chain (without readlink -f, which macOS sh lacks) before looking for the
# CLI next to this script.
self=$0
hops=0
while [ -L "$self" ] && [ "$hops" -lt 40 ]; do
    link=$(readlink "$self") || break
    case $link in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
    hops=$((hops + 1))
done
# -P: a logical cd would apply .. to the link's spelling, not to where it points.
root=$(CDPATH= cd -P -- "$(dirname "$self")/.." 2>/dev/null && pwd -P) || {
    echo "jstack: cannot locate the plugin payload from $self" >&2
    exit 127
}
main=$root/cli/main.js
if [ ! -f "$main" ]; then
    echo "jstack: no CLI at $main (this launcher must stay inside the installed jstack plugin)" >&2
    exit 127
fi
# An exported shell function named node would satisfy command -v but not exec.
unset -f node 2>/dev/null
node=$(command -v node 2>/dev/null) || node=
case $node in
    /*) ;;
    '')
        echo "jstack: node is not on PATH; install Node.js 20 or newer" >&2
        exit 127
        ;;
    *)
        echo "jstack: node on PATH is not an absolute path ($node); use an absolute PATH entry" >&2
        exit 127
        ;;
esac
exec "$node" "$main" "$@"
